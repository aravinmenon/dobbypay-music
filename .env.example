# Copy values into Render → Service → Environment
PORT=10000
NODE_ENV=production

# Clever Cloud MySQL (same as local .env)
DB_HOST=bcw5w0mjp4y7krkq9bgo-mysql.services.clever-cloud.com
DB_PORT=22207
DB_USER=your_mysql_user
DB_PASS=your_mysql_password
DB_NAME=your_mysql_database
DB_SSL=true
DB_CHARSET=utf8mb4

MYSQL_ADDON_HOST=bcw5w0mjp4y7krkq9bgo-mysql.services.clever-cloud.com
MYSQL_ADDON_PORT=22207
MYSQL_ADDON_USER=your_mysql_user
MYSQL_ADDON_PASSWORD=your_mysql_password
MYSQL_ADDON_DB=your_mysql_database

AUTO_APPROVE_USERS=false
ADMIN_WHATSAPP=+919597072006
SUPER_ADMIN_WHATSAPP=+919597072006

# Optional: true auto-send WhatsApp (otherwise app opens wa.me link)
# Meta Cloud API: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=hello_world
# WHATSAPP_TEMPLATE_LANG=en

# Or Twilio WhatsApp
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Or CallMeBot (simple admin notify): https://www.callmebot.com/blog/free-api-whatsapp-messages/
# CALLMEBOT_APIKEY=

ALLOWED_ORIGINS=https://dobbypay-music.onrender.com,capacitor://localhost,https://localhost,http://localhost:3000

# Production Express API on Render — rebuild APK after changing these
VITE_API_BASE_URL=https://dobbypay-music.onrender.com/api
VITE_PUBLIC_API_URL=https://dobbypay-music.onrender.com/api
VITE_SONGS_API_URL=https://dobbypay-music.onrender.com/api/songs

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLYTO=
